# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in your real values.
# NEVER commit your ".env" file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Google AI Studio API key (FREE, no credit card required)
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# LLM: Gemini 2.0 Flash (free tier on Google AI Studio)
CHAT_MODEL=gemini-2.0-flash

# Embeddings: local HuggingFace model — no API key needed, runs on your machine
# Do NOT change this unless you re-run ingest.py with the new model name
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

